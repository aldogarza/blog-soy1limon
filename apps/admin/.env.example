# Local-only admin. Copy to .env and fill in. Validated by adminEnvSchema (packages/core/src/env.ts).
# This file holds the only privileged credentials of the project. Never commit the real .env.
SUPABASE_URL=
# Secret key (sb_secret_…) from Supabase dashboard > Project Settings > API Keys.
SUPABASE_SECRET_KEY=

# `local-fs` stores images under .media-local/ for development; `r2` uses Cloudflare R2.
STORAGE_DRIVER=local-fs
MEDIA_BASE_URL=http://127.0.0.1:4322/media

# Required only when STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=
R2_ORIGINALS_BUCKET=

# Optional until phase 7: fine-grained token (this repo only) used to trigger deploys
GITHUB_REPO=
GITHUB_TOKEN=
