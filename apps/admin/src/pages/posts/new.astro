---
import { DEFAULT_LOCALE } from '@soy1limon/core';
import { actions } from 'astro:actions';
import AdminLayout from '../../layouts/AdminLayout.astro';

const result = Astro.getActionResult(actions.posts.create);
if (result?.data) return Astro.redirect(`/posts/${result.data.id}`);
---

<AdminLayout title="New post">
  {result?.error && (
    <p role="alert" class="error">
      {result.error.message}
    </p>
  )}
  <form method="POST" action={actions.posts.create}>
    <fieldset>
      <legend>Language of the post</legend>
      <p>
        <input type="radio" id="lang-en" name="lang" value="en" checked={DEFAULT_LOCALE === 'en'} />
        <label for="lang-en">English</label>
      </p>
      <p>
        <input type="radio" id="lang-es" name="lang" value="es" checked={DEFAULT_LOCALE === 'es'} />
        <label for="lang-es">Spanish</label>
      </p>
    </fieldset>
    <label for="title">Title</label>
    <span id="title-hint" class="hint">
      You can change it later. The address is suggested from it.
    </span>
    <input id="title" name="title" type="text" aria-describedby="title-hint" required />
    <p>
      <button type="submit">Create draft</button>
    </p>
  </form>
</AdminLayout>
