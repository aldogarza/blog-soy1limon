---
// Wide data tables scroll on their own instead of the page (WCAG 1.4.10 at 320 px). The region is
// focusable so keyboard users can scroll it with the arrow keys.
interface Props {
  /** Id of the table's caption: the region takes its name from it, so the text is not repeated. */
  labelledby: string;
}

const { labelledby } = Astro.props;
---

<div class="table-scroll" role="region" aria-labelledby={labelledby} tabindex="0">
  <slot />
</div>
