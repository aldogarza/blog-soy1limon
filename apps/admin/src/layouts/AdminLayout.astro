---
interface Props {
  /** Page title for <title> and, unless the page fills the "heading" slot, the h1. */
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: '/', label: 'Dashboard' },
  { href: '/posts', label: 'Posts' },
  { href: '/posts/new', label: 'New post' },
  { href: '/media', label: 'Media library' },
  { href: '/media/upload', label: 'Upload images' },
];

// Exact page, or "true" for the section the page belongs to (e.g. a post being edited).
const current = (href: string) =>
  path === href
    ? 'page'
    : href !== '/' && path.startsWith(`${href}/`) && !nav.some((item) => item.href === path)
      ? 'true'
      : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · soy1limon admin</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to main content
    </a>
    <header class="admin-header">
      <p class="admin-brand">
        <strong>soy1limon admin</strong> <span class="hint">Local only · never deployed</span>
      </p>
      <nav class="admin-nav" aria-label="Main">
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current(item.href)}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <h1>
        <slot name="heading">{title}</slot>
      </h1>
      <slot />
    </main>
  </body>
</html>
