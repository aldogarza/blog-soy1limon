# Public site build. Copy to .env and fill in. Validated by webEnvSchema (packages/core/src/env.ts).
# `fixtures` builds offline from packages/db/fixtures; `supabase` reads published content.
CONTENT_SOURCE=fixtures
# `production` only in the deploy workflow: enables indexing and analytics (see docs/seo.md).
DEPLOY_ENV=development
# Canonical origin of the public site, e.g. https://example.com
SITE_URL=http://localhost:4321
# Public base URL of the image variants (R2 custom domain), e.g. https://img.example.com
# Optional with fixtures (defaults to the sample images in public/fixtures-media).
MEDIA_BASE_URL=
# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Publishable key (sb_publishable_…). NEVER the secret/service_role key: the build must only see published rows.
SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Web Analytics site token (public). Only used when DEPLOY_ENV=production.
CLOUDFLARE_WEB_ANALYTICS_TOKEN=
# Optional Google Search Console meta verification token (DNS verification needs nothing here).
GOOGLE_SITE_VERIFICATION=
