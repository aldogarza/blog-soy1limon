---
import { type Locale, mediaUrl, ui } from '@soy1limon/core';
import type { PublicImage } from '@soy1limon/db';
import { mediaBaseUrl } from '../lib/env.ts';
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
  images: PublicImage[];
  lang: Locale;
}

const { images, lang } = Astro.props;
const t = ui(lang);
const base = mediaBaseUrl();
// Grid of ~12rem cells: phones get one column, wider screens several.
const sizes = '(min-width: 48rem) 16rem, 100vw';
const labels = {
  dialog: t.gallery,
  previous: t.previousPhoto,
  next: t.nextPhoto,
  close: t.closePhoto,
  position: t.photoPosition,
};
---

<section class="gallery" aria-labelledby="gallery-heading" data-lightbox={JSON.stringify(labels)}>
  <h2 id="gallery-heading">{t.gallery}</h2>
  <ul>
    {images.map((image) => {
      const largest = image.variants.at(-1);
      const caption = image.caption[lang];
      return (
        <li>
          <figure>
            <a href={largest ? mediaUrl(base, largest.key) : undefined}>
              <ResponsiveImage image={image} lang={lang} sizes={sizes} />
              <span class="visually-hidden"> ({t.openFullSize})</span>
            </a>
            {caption && <figcaption>{caption}</figcaption>}
          </figure>
        </li>
      );
    })}
  </ul>
</section>

<script>
  // Progressive enhancement: without JavaScript every photo link opens the full-size file.
  // With it, photos open in a modal <dialog>, which keeps focus inside, closes with Esc and gives
  // focus back to the photo that opened it. Arrow keys move between photos.
  interface Labels {
    dialog: string;
    previous: string;
    next: string;
    close: string;
    position: string;
  }

  function element<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className: string,
    text?: string,
  ): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    node.className = className;
    if (text) node.textContent = text;
    return node;
  }

  function button(className: string, label: string, onClick: () => void) {
    const node = element('button', className, label);
    node.type = 'button';
    node.addEventListener('click', onClick);
    return node;
  }

  function enhance(gallery: HTMLElement) {
    const labels = JSON.parse(gallery.dataset.lightbox ?? '{}') as Labels;
    const links = [...gallery.querySelectorAll<HTMLAnchorElement>('li a[href]')];
    if (links.length === 0) return;

    const dialog = element('dialog', 'lightbox');
    dialog.setAttribute('aria-label', labels.dialog);
    const figure = element('figure', 'lightbox-figure');
    const image = element('img', 'lightbox-image');
    const caption = element('figcaption', 'lightbox-caption');
    const position = element('p', 'lightbox-position');
    position.setAttribute('aria-live', 'polite');
    // The image joins the dialog on first use, so the page never holds an <img> without alt.
    figure.append(caption);

    let current = 0;
    let opener: HTMLAnchorElement | undefined;

    function show(index: number) {
      current = (index + links.length) % links.length;
      const link = links[current];
      const tile = link?.querySelector('img');
      if (!link || !tile) return;
      if (!image.isConnected) figure.prepend(image);
      image.src = link.href;
      image.srcset = tile.srcset;
      image.sizes = '100vw';
      image.alt = tile.alt;
      image.width = tile.width;
      image.height = tile.height;
      caption.textContent = link.closest('figure')?.querySelector('figcaption')?.textContent ?? '';
      caption.hidden = !caption.textContent;
      position.textContent = labels.position
        .replace('{n}', String(current + 1))
        .replace('{total}', String(links.length));
    }

    const controls = element('div', 'lightbox-controls');
    const next = button('lightbox-next', labels.next, () => show(current + 1));
    const close = button('lightbox-close', labels.close, () => dialog.close());
    if (links.length > 1) {
      controls.append(
        button('lightbox-previous', labels.previous, () => show(current - 1)),
        next,
      );
    }
    controls.append(close);
    dialog.append(figure, position, controls);
    gallery.append(dialog);

    dialog.addEventListener('keydown', (event) => {
      if (links.length < 2) return;
      if (event.key === 'ArrowRight') show(current + 1);
      else if (event.key === 'ArrowLeft') show(current - 1);
      else return;
      event.preventDefault();
    });
    // A click on the dimmed backdrop (outside the photo and the buttons) closes the viewer.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => opener?.focus());

    links.forEach((link, index) => {
      link.addEventListener('click', (event) => {
        // Keep the browser's behaviour for "open in a new tab" and similar.
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey) return;
        event.preventDefault();
        opener = link;
        show(index);
        dialog.showModal();
        (links.length > 1 ? next : close).focus();
      });
    });
  }

  document.querySelectorAll<HTMLElement>('.gallery[data-lightbox]').forEach(enhance);
</script>
