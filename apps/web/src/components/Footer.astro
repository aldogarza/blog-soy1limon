---
import { type Locale, rssPath, siteConfig, ui } from '@soy1limon/core';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui(lang);
---

<footer class="site-footer">
  <p>
    <small>{t.copyright(new Date().getFullYear(), siteConfig.author.name)}</small> ·{' '}
    <a href={rssPath(lang)}>{t.rss}</a>
  </p>
</footer>
