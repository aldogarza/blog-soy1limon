---
import { homePath, type Locale, otherLocale, searchPath, siteConfig, ui } from '@soy1limon/core';

interface Props {
  lang: Locale;
  alternatePath?: string | undefined;
}

const { lang, alternatePath } = Astro.props;
const t = ui(lang);
const other = otherLocale(lang);
const messages = {
  one: t.searchResults(1),
  other: t.searchResults(2).replace('2', '{n}'),
  none: t.searchNoResults,
};
---

<header class="site-header">
  <p class="site-brand">
    <a href={homePath(lang)}>{siteConfig.title[lang]}</a>
  </p>
  <form
    class="site-search"
    role="search"
    action={searchPath(lang)}
    method="get"
    data-messages={JSON.stringify(messages)}
  >
    <label class="visually-hidden" for="site-search-input">
      {t.searchLabel}
    </label>
    <input
      id="site-search-input"
      name="q"
      type="search"
      placeholder={t.searchPlaceholder}
      autocomplete="off"
      enterkeyhint="search"
    />
    <div class="search-panel" tabindex="-1" hidden>
      <ol></ol>
      <p>
        <a href={searchPath(lang)}>{t.searchAllResults}</a>
      </p>
    </div>
    <p class="visually-hidden" role="status"></p>
  </form>
  <p class="lang-switch">
    <a href={alternatePath ?? homePath(other)} hreflang={other} lang={other}>
      {t.otherLanguageName}
    </a>
  </p>
</header>

<script>
  // Progressive enhancement: without JavaScript the form opens the search page. With it, results
  // appear under the bar while typing. Pagefind is only downloaded once the field gets focus.
  interface Messages {
    one: string;
    other: string;
    none: string;
  }
  interface PagefindResult {
    data: () => Promise<{ url: string; excerpt: string; meta: { title?: string } }>;
  }
  interface Pagefind {
    search: (query: string) => Promise<{ results: PagefindResult[] }>;
  }

  const MAX_RESULTS = 6;
  let pagefind: Promise<Pagefind> | undefined;

  function loadPagefind(): Promise<Pagefind> {
    // Generated by Pagefind after the Astro build, so it can only be loaded at runtime. It picks
    // the index of the page's <html lang>, so results stay in the page's language.
    const url = '/pagefind/pagefind.js';
    pagefind ??= import(/* @vite-ignore */ url) as Promise<Pagefind>;
    return pagefind;
  }

  function enhance(form: HTMLFormElement) {
    const input = form.querySelector<HTMLInputElement>('input[type="search"]');
    const panel = form.querySelector<HTMLElement>('.search-panel');
    const list = panel?.querySelector('ol');
    const allItem = panel?.querySelector('p');
    const all = allItem?.querySelector('a');
    const status = form.querySelector<HTMLElement>('[role="status"]');
    if (!input || !panel || !list || !allItem || !all || !status) return;
    const messages = JSON.parse(form.dataset.messages ?? '{}') as Messages;
    let timer: number | undefined;
    let latest = 0;

    const links = () => [...panel.querySelectorAll<HTMLAnchorElement>('a')];
    const close = () => {
      panel.hidden = true;
    };

    const run = async (query: string) => {
      const id = ++latest;
      const text = query.trim();
      if (!text) {
        close();
        list.replaceChildren();
        status.textContent = '';
        return;
      }
      const search = await (await loadPagefind()).search(text);
      const results = await Promise.all(
        search.results.slice(0, MAX_RESULTS).map((result) => result.data()),
      );
      // A slower, older search must not overwrite the results of the newer one.
      if (id !== latest) return;
      const total = search.results.length;
      list.replaceChildren(
        ...results.map((result) => {
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = result.url;
          link.textContent = result.meta.title ?? result.url;
          const excerpt = document.createElement('p');
          // Pagefind excerpts are plain text from our own pages with <mark> highlights only.
          excerpt.innerHTML = result.excerpt;
          item.append(link, excerpt);
          return item;
        }),
      );
      const summary =
        total === 0
          ? messages.none
          : total === 1
            ? messages.one
            : messages.other.replace('{n}', String(total));
      if (total === 0) {
        const empty = document.createElement('li');
        empty.textContent = summary;
        list.append(empty);
      }
      all.href = `${form.action}?q=${encodeURIComponent(text)}`;
      allItem.hidden = total === 0;
      status.textContent = summary;
      // Typing then quickly tabbing away must not reopen the panel.
      panel.hidden = !form.contains(document.activeElement);
    };

    // Results from an earlier search come back on a click or the down arrow, never just because
    // the focus returns (Escape sends it back here and must leave the panel closed).
    const reopen = () => {
      const hasResults = input.value.trim() !== '' && list.childElementCount > 0;
      if (hasResults) panel.hidden = false;
      return hasResults;
    };
    input.addEventListener('focus', () => void loadPagefind().catch(() => undefined));
    input.addEventListener('click', reopen);
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => void run(input.value), 150);
    });

    form.addEventListener('keydown', (event) => {
      const items = links();
      const index = items.indexOf(document.activeElement as HTMLAnchorElement);
      if (event.key === 'Escape' && !panel.hidden) {
        close();
        input.focus();
      } else if (event.key === 'ArrowDown' && (!panel.hidden || reopen())) {
        items[Math.min(index + 1, items.length - 1)]?.focus();
      } else if (event.key === 'ArrowUp' && index >= 0) {
        if (index === 0) input.focus();
        else items[index - 1]?.focus();
      } else {
        return;
      }
      event.preventDefault();
    });
    // Leaving the search (Tab past the results, a click elsewhere) closes the panel.
    form.addEventListener('focusout', (event) => {
      if (!form.contains(event.relatedTarget as Node | null)) close();
    });
  }

  document.querySelectorAll<HTMLFormElement>('form.site-search').forEach(enhance);
</script>
