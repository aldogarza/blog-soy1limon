---
import { type Locale, siteConfig, ui } from '@soy1limon/core';
import Analytics from '../components/Analytics.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SeoHead, { type SeoProps } from '../components/SeoHead.astro';
import '../styles/base.css';

interface Props {
  lang: Locale;
  /** Page title without the site name. */
  title: string;
  description: string;
  /** The same page in the other language (used for hreflang and the language switch). */
  translationPath?: string | undefined;
  seo?: SeoProps;
}

const { lang, title, description, translationPath, seo = {} } = Astro.props;
const t = ui(lang);
const fullTitle = title === siteConfig.title[lang] ? title : `${title} · ${siteConfig.title[lang]}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <SeoHead
      lang={lang}
      title={title}
      description={description}
      translationPath={translationPath}
      {...seo}
    />
    <slot name="head" />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.skipToContent}
    </a>
    <Header lang={lang} alternatePath={translationPath} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
