---
import { blogPath, homePath, type Locale, tagPath, ui } from '@soy1limon/core';
import Gallery from '../components/Gallery.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { type SitePost, siteContent, tagLabel } from '../lib/content.ts';
import { mediaBaseUrl } from '../lib/env.ts';
import { formatDate } from '../lib/format.ts';
import { blogPostingJsonLd, breadcrumbJsonLd, ogImageFor } from '../lib/seo.ts';

interface Props {
  post: SitePost;
}

const { post } = Astro.props;
const lang: Locale = post.lang;
const t = ui(lang);
const published = formatDate(post.publishedAt, lang);
const updated = formatDate(post.updatedAt, lang);

// Every photo of the post (cover, gallery, inline), in order, for structured data and the share image.
const { images } = await siteContent();
const photos = [
  ...new Set(
    [post.coverImageId, ...post.galleryImageIds, ...post.inlineImageIds].filter(
      (id) => id !== null,
    ),
  ),
]
  .map((id) => images.get(id))
  .filter((image) => image !== undefined);
const site = Astro.site ?? '';
const tagNames = post.tags.map((tag) => tagLabel(tag, lang));
const seo = {
  type: 'article' as const,
  image: photos[0] ? ogImageFor(photos[0], lang, mediaBaseUrl(), site) : undefined,
  article: { publishedTime: post.publishedAt, modifiedTime: post.updatedAt, tags: tagNames },
  jsonLd: [
    blogPostingJsonLd({ ...post, tags: tagNames, images: photos }, mediaBaseUrl(), site),
    breadcrumbJsonLd(
      [
        { name: t.home, path: homePath(lang) },
        { name: t.blog, path: blogPath(lang) },
        { name: post.title, path: post.path },
      ],
      site,
    ),
  ],
};
---

<BaseLayout
  lang={lang}
  title={post.title}
  description={post.description}
  translationPath={post.translation?.path}
  seo={seo}
>
  <article data-pagefind-body>
    <header>
      <h1>{post.title}</h1>
      <p>
        {t.publishedOn} <time datetime={post.publishedAt}>{published}</time>
        {updated !== published && (
          <>
            {' · '}
            {t.updatedOn} <time datetime={post.updatedAt}>{updated}</time>
          </>
        )}
        {' · '}
        {t.readingTime(post.readingMinutes)}
      </p>
      {post.tags.length > 0 && (
        <p>
          {t.taggedWith}:{' '}
          {post.tags.map((tag, index) => (
            <>
              {index > 0 && ', '}
              <a href={tagPath(lang, tag.slug)} rel="tag">
                {tagLabel(tag, lang)}
              </a>
            </>
          ))}
        </p>
      )}
      {post.translation && (
        <p>
          <a
            href={post.translation.path}
            hreflang={post.translation.lang}
            lang={post.translation.lang}
          >
            {t.readInOtherLanguage}: {post.translation.title}
          </a>
        </p>
      )}
    </header>

    {post.cover && (
      <figure>
        <ResponsiveImage image={post.cover} lang={lang} priority />
        {post.cover.caption[lang] && <figcaption>{post.cover.caption[lang]}</figcaption>}
      </figure>
    )}

    <Fragment set:html={post.html} />

    {post.gallery.length > 0 && <Gallery images={post.gallery} lang={lang} />}
  </article>
</BaseLayout>
