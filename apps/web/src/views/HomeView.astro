---
import { archivePath, homePath, type Locale, otherLocale, siteConfig, ui } from '@soy1limon/core';
import LoadMore from '../components/LoadMore.astro';
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteArchive } from '../lib/archive.ts';
import { postsIn, siteContent } from '../lib/content.ts';
import { websiteJsonLd } from '../lib/seo.ts';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui(lang);
// The home page is also the start of the archive: the newest posts, then every other one.
const { recent, pages } = siteArchive(postsIn(await siteContent(), lang));
const [first] = pages;
const more = first?.items ?? [];
const next = first && first.totalPages > 1 ? archivePath(lang, 2) : undefined;
---

<BaseLayout
  lang={lang}
  title={siteConfig.title[lang]}
  description={siteConfig.description[lang]}
  translationPath={homePath(otherLocale(lang))}
  seo={{ jsonLd: [websiteJsonLd(lang, homePath(lang), Astro.site ?? '')] }}
>
  <h1>{siteConfig.title[lang]}</h1>
  <p class="page-intro">{siteConfig.description[lang]}</p>
  <section class="latest-posts" aria-labelledby="latest-heading">
    <h2 id="latest-heading">{t.latestPosts}</h2>
    <PostList posts={recent} lang={lang} headingLevel={3} />
  </section>
  {more.length > 0 && (
    <section class="more-posts" aria-labelledby="more-heading">
      <h2 id="more-heading">{t.morePosts}</h2>
      <PostList posts={more} lang={lang} headingLevel={3} eagerFirst={false} />
      {next && <LoadMore lang={lang} next={next} />}
    </section>
  )}
</BaseLayout>
