---
import { archivePath, homePath, type Locale, siteConfig, ui } from '@soy1limon/core';
import Pagination from '../components/Pagination.astro';
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { SitePost } from '../lib/content.ts';
import type { Page } from '../lib/paginate.ts';
import { breadcrumbJsonLd } from '../lib/seo.ts';

interface Props {
  lang: Locale;
  /** Page 2 or later of the archive (page 1 is the home page). */
  page: Page<SitePost>;
}

const { lang, page } = Astro.props;
const t = ui(lang);
const title = `${t.morePosts} · ${t.page(page.page, page.totalPages)}`;
const breadcrumb = breadcrumbJsonLd(
  [
    { name: t.home, path: homePath(lang) },
    { name: title, path: archivePath(lang, page.page) },
  ],
  Astro.site ?? '',
);
---

<BaseLayout
  lang={lang}
  title={title}
  description={siteConfig.description[lang]}
  seo={{ jsonLd: [breadcrumb] }}
>
  <h1>{title}</h1>
  <PostList posts={page.items} lang={lang} />
  <Pagination lang={lang} page={page.page} totalPages={page.totalPages} />
</BaseLayout>
