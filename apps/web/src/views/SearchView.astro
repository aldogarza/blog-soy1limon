---
import { blogPath, type Locale, otherLocale, searchPath, siteConfig, ui } from '@soy1limon/core';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui(lang);
// The page shows at most 20 results, so every count message is prepared at build time.
const MAX_RESULTS = 20;
const messages = {
  counts: Array.from({ length: MAX_RESULTS + 1 }, (_, n) => t.searchResults(n)),
  none: t.searchNoResults,
};
---

<BaseLayout
  lang={lang}
  title={t.search}
  description={siteConfig.description[lang]}
  alternatePath={searchPath(otherLocale(lang))}
>
  <h1>{t.search}</h1>
  <form role="search" id="search-form" data-messages={JSON.stringify(messages)}>
    <label for="search-input">{t.searchLabel}</label>
    <input id="search-input" name="q" type="search" autocomplete="off" />
    <button type="submit">{t.searchButton}</button>
  </form>
  <noscript>
    <p>
      {t.searchNeedsJs} <a href={blogPath(lang)}>{t.allPosts}</a>
    </p>
  </noscript>
  <p id="search-status" role="status" aria-live="polite"></p>
  <ol id="search-results"></ol>
</BaseLayout>

<script>
  // Pagefind builds one index per <html lang>, so this page only searches posts in its language.
  interface PagefindResult {
    data: () => Promise<{ url: string; excerpt: string; meta: { title?: string } }>;
  }
  interface Pagefind {
    search: (query: string) => Promise<{ results: PagefindResult[] }>;
  }

  const form = document.querySelector<HTMLFormElement>('#search-form');
  const input = document.querySelector<HTMLInputElement>('#search-input');
  const status = document.querySelector<HTMLElement>('#search-status');
  const list = document.querySelector<HTMLOListElement>('#search-results');
  let pagefind: Pagefind | undefined;

  async function run(query: string) {
    if (!form || !status || !list) return;
    const messages = JSON.parse(form.dataset.messages ?? '{}') as {
      counts: string[];
      none: string;
    };
    list.replaceChildren();
    if (!query.trim()) {
      status.textContent = '';
      return;
    }
    // Generated by Pagefind after the Astro build, so it can only be loaded at runtime.
    const pagefindUrl = '/pagefind/pagefind.js';
    pagefind ??= (await import(/* @vite-ignore */ pagefindUrl)) as Pagefind;
    const search = await pagefind.search(query);
    const results = await Promise.all(search.results.slice(0, 20).map((result) => result.data()));
    status.textContent =
      results.length === 0 ? messages.none : (messages.counts[results.length] ?? '');
    for (const result of results) {
      const item = document.createElement('li');
      const link = document.createElement('a');
      link.href = result.url;
      link.textContent = result.meta.title ?? result.url;
      const excerpt = document.createElement('p');
      // Pagefind excerpts are plain text from our own pages with <mark> highlights only.
      excerpt.innerHTML = result.excerpt;
      item.append(link, excerpt);
      list.append(item);
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const query = input?.value ?? '';
    history.replaceState(null, '', `?q=${encodeURIComponent(query)}`);
    void run(query);
  });

  const initial = new URLSearchParams(location.search).get('q');
  if (initial && input) {
    input.value = initial;
    void run(initial);
  }
</script>
