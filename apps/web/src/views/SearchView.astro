---
import { homePath, type Locale, otherLocale, searchPath, siteConfig, ui } from '@soy1limon/core';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui(lang);
// The page shows at most 20 results, so every count message is prepared at build time.
const MAX_RESULTS = 20;
const messages = {
  counts: Array.from({ length: MAX_RESULTS + 1 }, (_, n) => t.searchResults(n)),
  none: t.searchNoResults,
  hint: t.searchHint,
};
---

<BaseLayout
  lang={lang}
  title={t.search}
  description={siteConfig.description[lang]}
  translationPath={searchPath(otherLocale(lang))}
  seo={{ noindex: true }}
>
  <h1>{t.search}</h1>
  <noscript>
    <p>
      {t.searchNeedsJs} <a href={homePath(lang)}>{t.allPosts}</a>
    </p>
  </noscript>
  <p class="search-status" role="status" data-messages={JSON.stringify(messages)}></p>
  <ol class="search-results"></ol>
</BaseLayout>

<script>
  // Full results for the query typed in the header's search box (?q=...). Pagefind builds one index
  // per <html lang>, so this page only searches posts in its language.
  interface PagefindResult {
    data: () => Promise<{ url: string; excerpt: string; meta: { title?: string } }>;
  }
  interface Pagefind {
    search: (query: string) => Promise<{ results: PagefindResult[] }>;
  }

  const status = document.querySelector<HTMLElement>('.search-status');
  const list = document.querySelector<HTMLOListElement>('.search-results');
  const input = document.querySelector<HTMLInputElement>('.site-search input[type="search"]');

  async function run(query: string) {
    if (!status || !list) return;
    const messages = JSON.parse(status.dataset.messages ?? '{}') as {
      counts: string[];
      none: string;
      hint: string;
    };
    if (!query.trim()) {
      status.textContent = messages.hint;
      return;
    }
    // Generated by Pagefind after the Astro build, so it can only be loaded at runtime.
    const pagefindUrl = '/pagefind/pagefind.js';
    const pagefind = (await import(/* @vite-ignore */ pagefindUrl)) as Pagefind;
    const search = await pagefind.search(query);
    const results = await Promise.all(search.results.slice(0, 20).map((result) => result.data()));
    status.textContent =
      results.length === 0 ? messages.none : (messages.counts[results.length] ?? '');
    for (const result of results) {
      const item = document.createElement('li');
      const link = document.createElement('a');
      link.href = result.url;
      link.textContent = result.meta.title ?? result.url;
      const excerpt = document.createElement('p');
      // Pagefind excerpts are plain text from our own pages with <mark> highlights only.
      excerpt.innerHTML = result.excerpt;
      item.append(link, excerpt);
      list.append(item);
    }
  }

  const query = new URLSearchParams(location.search).get('q') ?? '';
  // Keep the query in the header's box, so it can be refined from there.
  if (input) input.value = query;
  void run(query);
</script>
