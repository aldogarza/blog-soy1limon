---
import type { GetStaticPaths } from 'astro';
import type { Tag } from '@soy1limon/db';
import { type SitePost, siteContent, tagsIn } from '../../../lib/content.ts';
import TagView from '../../../views/TagView.astro';

export const getStaticPaths = (async () => {
  const entries = tagsIn(await siteContent(), 'es');
  return entries.map(({ tag, posts }) => ({ params: { tag: tag.slug }, props: { tag, posts } }));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props as { tag: Tag; posts: SitePost[] };
---

<TagView lang="es" tag={tag} posts={posts} />
